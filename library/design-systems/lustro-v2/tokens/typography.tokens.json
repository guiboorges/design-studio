{
  "$description": "Lustro v2 text styles (v2/*). Plus Jakarta Sans. letterSpacing in % of font size as in Figma.",
  "font": {
    "family": {
      "$type": "fontFamily",
      "$value": [
        "Plus Jakarta Sans",
        "system-ui",
        "-apple-system",
        "Segoe UI",
        "sans-serif"
      ]
    }
  },
  "type": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family}",
        "fontWeight": 700,
        "fontSize": {
          "value": 40,
          "unit": "px"
        },
        "lineHeight": 1.15,
        "letterSpacing": {
          "value": -0.8,
          "unit": "px"
        }
      },
      "$extensions": {
        "lustro": {
          "lineHeightPx": 46,
          "letterSpacingPercent": -2,
          "textTransform": "none"
        }
      }
    },

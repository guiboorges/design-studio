{
  "font": {
    "family": {
      "$type": "fontFamily",
      "$value": [
        "Manrope",
        "system-ui",
        "sans-serif"
      ]
    }
  },
  "type": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family}",
        "fontSize": {
          "value": 40,
          "unit": "px"
        },
        "lineHeight": 1.2,
        "fontWeight": 600,
        "letterSpacing": {
          "value": -0.02,
          "unit": "em"
        }
      },
      "$extensions": {
        "summit": {
          "figmaStyle": "Display",
          "lineHeightPx": 48,
          "uppercase": false,
          "tabularNums": false
        }
      }
    },
    "heading-h1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family}",
        "fontSize": {
          "value": 32,
          "unit": "px"
        },
        "lineHeight": 1.25,
        "fontWeight": 600,
        "letterSpacing": {
          "value": -0.015,
          "unit": "em"
        }
      },
      "$extensions": {
        "summit": {
          "figmaStyle": "Heading/H1",
          "lineHeightPx": 40,
          "uppercase": false,
          "tabularNums": false
        }
      }
    },
    "heading-h2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family}",
        "fontSize": {
          "value": 24,
          "unit": "px"
        },
        "lineHeight": 1.3333333333333333,
        "fontWeight": 600,
        "letterSpacing": {
          "value": -0.01,
          "unit": "em"
        }
      },
      "$extensions": {
        "summit": {
          "figmaStyle": "Heading/H2",
          "lineHeightPx": 32,
          "uppercase": false,
          "tabularNums": false
        }
      }
    },
    "heading-h3": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family}",
        "fontSize": {
          "value": 20,
          "unit": "px"
        },
        "lineHeight": 1.4,
        "fontWeight": 600,
        "letterSpacing": {
          "value": -0.005,
          "unit": "em"
        }
      },
      "$extensions": {
        "summit": {
          "figmaStyle": "Heading/H3",
          "lineHeightPx": 28,
          "uppercase": false,
          "tabularNums": false
        }
      }
    },
    "title": {
      "$type": "typography",
